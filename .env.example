# Copy to .env and adjust. Docker Compose sets its own values and ignores this file.

DJANGO_SETTINGS_MODULE=core.settings.dev
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Business timezone: availability hours are entered in this timezone
TIME_ZONE=Asia/Tashkent

# PostgreSQL (required: double booking is prevented by a PostgreSQL exclusion constraint)
DB_NAME=booking
DB_USER=booking
DB_PASSWORD=booking
DB_HOST=127.0.0.1
DB_PORT=5432

# Celery / Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/2
# True = run tasks inline without a worker (handy for quick local runs)
CELERY_TASK_ALWAYS_EAGER=False

# Email: console backend prints emails in the terminal
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Booking <noreply@example.com>

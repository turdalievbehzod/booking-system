# Where the Vite dev server forwards /api requests (the Django backend)
VITE_PROXY_TARGET=http://localhost:8000

# Only needed when the frontend is deployed separately from the API (no proxy)
# VITE_API_URL=https://api.example.com/api/v1

# Must match Django's TIME_ZONE: slots and bookings are shown in this timezone
VITE_BUSINESS_TZ=Asia/Tashkent
VITE_BUSINESS_NAME=Studio Booking
VITE_CURRENCY=UZS
